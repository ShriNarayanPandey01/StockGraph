# ==============================================================================
# Telegram Bot Configuration
# ==============================================================================

# 1. Obtain a token by talking to @BotFather on Telegram (run /newbot)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# 2. Application Layer Endpoints (Upstox Data Service & StockGraph Service)
UPSTOX_SERVICE_URL=http://localhost:8001
STOCKGRAPH_SERVICE_URL=http://localhost:8000

# 3. Proactive Alert Settings
# Interval in seconds between automatic preemptive news/rising stock pushes
ALERT_INTERVAL_SECONDS=45

# Whether preemptive background broadcast is enabled (true/false)
ENABLE_PROACTIVE_ALERTS=true

# Storage file for subscriber chat IDs across restarts
SUBSCRIBERS_FILE=subscribers.json

