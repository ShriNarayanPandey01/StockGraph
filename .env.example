# --- TimescaleDB (PostgreSQL 16) ---
POSTGRES_USER=stockgraph
POSTGRES_PASSWORD=stockgraph
POSTGRES_DB=stockgraph
TIMESCALE_PORT=5432
TIMESCALE_DSN=postgresql://stockgraph:stockgraph@localhost:5432/stockgraph

# --- FalkorDB (graph + vector) ---
FALKOR_HOST=localhost
FALKOR_PORT=6379
FALKOR_BROWSER_PORT=3000
FALKOR_GRAPH_NAME=stock_graph

# --- Redis (cache / dedupe / rate-limit) ---
REDIS_PORT=6380
REDIS_URL=redis://localhost:6380/0

# --- App ---
APP_TIMEZONE=Asia/Kolkata
EMBEDDING_DIMENSION=1536

# --- L3 dedup tuning (Rule 5: settings, never hardcoded) ---
DEDUP_COSINE_THRESHOLD=0.92
DEDUP_WINDOW_HOURS=48
DEDUP_VECTOR_K=50
CORRELATION_MIN_COSINE=0.68
CORRELATION_WINDOW_DAYS=14
ONTOLOGY_MIN_CONFIDENCE=0.65

# --- LLM / embedding layer (Issue 1 mitigation) ---
# Kill-switch: false = fully offline (no network calls; CI-safe).
LLM_ENABLED=false
LLM_CHAT_MODEL=gpt-4o-mini
LLM_ONTOLOGY_MODEL=gpt-4o
EMBEDDING_MODEL=text-embedding-3-small
LLM_MAX_TOKENS_PER_CALL=4000
LLM_MONTHLY_USD_CAP=50.0
LLM_CACHE_TTL_DAYS=30
OPENAI_API_KEY=
# --- NSE sourcing (Issue 2 mitigation) ---
# Bhavcopy-primary with vendor fallback; throttle to respect ToS/Akamai.
BHAVCOPY_PRIMARY=true
NSE_REQUESTS_PER_SECOND=1.0
NSE_TIMEOUT_SECONDS=30
NSE_MAX_RETRIES=3
NSE_BACKOFF_BASE_SECONDS=1.0
# Per-1k-token USD prices for budget pre-flight estimates.
EMBEDDING_PRICE_PER_1K=0.00002
CHAT_PRICE_PER_1K=0.00015
