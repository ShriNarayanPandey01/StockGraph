# Copy to .env and fill the values marked [SECRET]. This file is a template:
# secrets are never committed. See the keys listed in the "SECRETS CHECKLIST".
#
# SECRETS CHECKLIST (fill these in .env manually):
#   1. OPENAI_API_KEY              - required separately for OpenAI embeddings
#   2. BASETEN_API_KEY             - required when LLM_PROVIDER=baseten
#   3. UPSTOX_ANALYTICS_TOKEN      - read-only Analytics Token
#   4. MARKETAUX_API_KEY           - optional news source
#   5. CURRENT_NEWS_API_KEY        - optional news source
#   6. FMP_API_KEY                 - optional news source
#   7. ALPHA_VANTAGE_API_KEY       - optional news source
#   8. PLATFORM_AGENT_SERVICE_KEY  - external-agent intake (empty=off)
#   9. DOCUMENT_INTERNAL_API_KEY   - operator document intake (empty=off)
#  10. PLATFORM_DB_PASSWORD        - change from the local default

# --- TimescaleDB (PostgreSQL 16) ---
POSTGRES_USER=stockgraph
POSTGRES_PASSWORD=stockgraph
POSTGRES_DB=stockgraph
TIMESCALE_PORT=5432
TIMESCALE_DSN=postgresql://stockgraph:stockgraph@localhost:5432/stockgraph

# --- FalkorDB (graph + vector) ---
FALKOR_HOST=localhost
FALKOR_PORT=6379
FALKOR_BROWSER_PORT=3000
FALKOR_GRAPH_NAME=stock_graph

# --- Redis (cache / dedupe / rate-limit) ---
REDIS_PORT=6380
REDIS_URL=redis://localhost:6380/0

# --- App ---
APP_TIMEZONE=Asia/Kolkata
EMBEDDING_DIMENSION=1536
# Developer-only FalkorDB relationship edits; set false to freeze manual links.
DEVELOPER_GRAPH_MUTATIONS_ENABLED=true

# --- L3 dedup tuning (Rule 5: settings, never hardcoded) ---
DEDUP_COSINE_THRESHOLD=0.92
DEDUP_WINDOW_HOURS=48
DEDUP_VECTOR_K=50
CORRELATION_MIN_COSINE=0.68
CORRELATION_WINDOW_DAYS=14
ONTOLOGY_MIN_CONFIDENCE=0.65

# --- LLM / embedding layer (Issue 1 mitigation) ---
# Kill-switch: false = fully offline (no network calls; CI-safe).
LLM_ENABLED=false
# Sample chat model: Meta Muse Spark served by Baseten; see docs/AI_AND_MODEL_USAGE.md.
LLM_PROVIDER=baseten
LLM_JSON_MODE=auto
AGENTS_LLM_REASONING_EFFORT=low
LLM_CHAT_MODEL=meta-models/muse-spark-open-1026
LLM_ONTOLOGY_MODEL=meta-models/muse-spark-open-1026
# Embeddings use a separate provider/model from chat inference.
EMBEDDING_MODEL=text-embedding-3-small
LLM_MAX_TOKENS_PER_CALL=4000
LLM_MONTHLY_USD_CAP=50.0
LLM_CACHE_TTL_DAYS=30
BASETEN_API_BASE=https://inference.baseten.co/v1
BASETEN_API_KEY=
# Keep the OpenAI key separate: it is used for embeddings.
OPENAI_API_KEY=
# Anthropic/OpenRouter use their provider keys. Other LiteLLM providers can use
# LLM_API_KEY and an optional LLM_API_BASE with a provider/model identifier.
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=
LLM_API_KEY=
LLM_API_BASE=
# These are budget estimates, not provider billing rates. Set them for the
# selected provider so the monthly spend guard uses a suitable estimate.
CHAT_PRICE_PER_1K=0.00015
EMBEDDING_PRICE_PER_1K=0.00002
# --- NSE sourcing (Issue 2 mitigation) ---
# Bhavcopy-primary with vendor fallback; throttle to respect ToS/Akamai.
BHAVCOPY_PRIMARY=true
NSE_REQUESTS_PER_SECOND=1.0
NSE_TIMEOUT_SECONDS=30
NSE_MAX_RETRIES=3
NSE_BACKOFF_BASE_SECONDS=1.0

# --- News API providers (Rule 5 news ingestion) ---------------------------
# Each key is optional: a provider without a key is reported as
# NOT_CONFIGURED and skipped. Add keys to .env (git-ignored) to enable.
# CURRENTS_API_KEY is also accepted as an alias of CURRENT_NEWS_API_KEY.
MARKETAUX_API_KEY=
CURRENT_NEWS_API_KEY=
FMP_API_KEY=
ALPHA_VANTAGE_API_KEY=
# Fetch order (lowest priority number is fetched first).
NEWS_PROVIDERS_ENABLED=marketaux,currents,alphavantage,fmp
# Requests per provider per hourly cycle; daily quotas are enforced separately.
NEWS_REQUESTS_PER_RUN=2
# Hard daily request budget per provider. Blank = use the provider's own
# plan limit (Marketaux 100/day, Currents 250/day, Alpha Vantage 25/day).
NEWS_DAILY_REQUEST_CAP=
# Fetch lookback. Marketaux's ticker-tagged articles lag its general feed
# by ~3.5h, so 720 min keeps them in range.
NEWS_LOOKBACK_MINUTES=720
NEWS_MAX_ARTICLES_PER_RUN=60
# Summaries are truncated before storage (provider terms grant snippets).
NEWS_SUMMARY_MAX_CHARS=600
# India feed filters (Currents).
NEWS_CURRENTS_COUNTRY=in
NEWS_CURRENTS_CATEGORIES=finance,economy,politics
NEWS_ELIGIBILITY_URL=http://localhost:8000/internal/v1/news/eligibility
NEWS_ELIGIBILITY_TIMEOUT_SECONDS=8
# Also run the untargeted India sweep next to the ticker-targeted query.
NEWS_CURRENTS_INCLUDE_BROAD=true
# Exchange suffix for Yahoo-style provider symbols: TATASTEEL -> TATASTEEL.NS
NEWS_SYMBOL_SUFFIX=.NS
# Unverified: Alpha Vantage's news endpoint is premium, so its Indian
# symbol format could not be validated against a live response.
NEWS_ALPHA_VANTAGE_SYMBOL_SUFFIX=.BSE
# Analytics Token: read-only, generated in Developer Apps, valid for one year.
# A standard OAuth access token can instead be supplied via UPSTOX_AUTHTOKEN;
# that token expires at 03:30 IST. Never put the API key here.
UPSTOX_ANALYTICS_TOKEN=

# --- Independent service APIs / reliable event transport ---
DATA_SERVICE_URL=http://localhost:8001
EVENT_STREAM=stockgraph:events:v1
EVENT_CONSUMER_GROUP=graph-v1
EVENT_RETRY_IDLE_MS=60000
EVENT_LEASE_SECONDS=1800
PAGINATION_SNAPSHOT_MAX_AGE_SECONDS=3600
JOB_MAX_ATTEMPTS=3
JOB_LEASE_SECONDS=600
UPSTOX_API_BASE_URL=https://api.upstox.com/v2
UPSTOX_API_V3_BASE_URL=https://api.upstox.com/v3
UPSTOX_TIMEOUT_SECONDS=30
UPSTOX_MAX_RETRIES=3
# On-demand market response cache: live vs dated/holiday results.
MARKET_LIVE_CACHE_TTL_SECONDS=30
MARKET_DATED_CACHE_TTL_SECONDS=3600

# --- Platform: ordinary PostgreSQL on the existing server ---
# Provision with platform-db-init (Compose) before starting the API.
PLATFORM_DB_USER=marketgraph_platform
PLATFORM_DB_PASSWORD=local-platform-change-me
PLATFORM_DATABASE_DSN=postgresql://marketgraph_platform:local-platform-change-me@localhost:5432/marketgraph_platform
PLATFORM_REDIS_URL=redis://localhost:6380/0
PLATFORM_DATA_SERVICE_URL=http://localhost:8001
PLATFORM_GRAPH_SERVICE_URL=http://localhost:8000
# Service credential for separately hosted agents. Empty disables machine intake.
PLATFORM_AGENT_SERVICE_KEY=
PLATFORM_OPERATIONAL_MAX_PENDING_JOBS_PER_USER=20
PLATFORM_AGENT_LEASE_SECONDS=300
PLATFORM_MAX_AGENT_ATTEMPTS=3
PLATFORM_MONITOR_MIN_INTERVAL_SECONDS=60
PROFESSIONAL_EVIDENCE_WEIGHT=1.5
PLATFORM_STREAM_NAME=stockgraph:platform-events:v1
PLATFORM_CONSUMER_GROUP=stockgraph-platform-v1
# Operator-only, permitted PDF/plain-text ingestion; no arbitrary URL fetching.
DOCUMENT_INTERNAL_API_KEY=
DOCUMENT_STORAGE_ROOT=./var/documents
DOCUMENT_MAX_BYTES=10485760
CHECKPOINT_CATCHUP_MAX_DAYS=30
# Payments are disabled; a future provider is undecided. Trading remains deferred.
UPSTOX_API_KEY=
UPSTOX_API_SECRET=
# Must exactly match the URI registered in Upstox Developer Apps.
UPSTOX_API_REDIRECT_URI=https://127.0.0.1:5000/
UPSTOX_AUTHTOKEN=

# --- Phase 2 internal REST access (set a strong independent secret) ---
# Required by Data/Graph domain routes and their internal clients.
MARKETGRAPH_INTERNAL_SERVICE_KEY=
# Local stdio MCP tools authenticate through Platform; no remote MCP server exists.
MARKETGRAPH_PLATFORM_URL=http://localhost:8002
MARKETGRAPH_PLATFORM_TOKEN=

# --- Environment-managed developer superuser (Platform API only) ---
PLATFORM_ADMIN_NAME=Developer
PLATFORM_ADMIN_EMAIL=admin@marketgraph.local
PLATFORM_ADMIN_PASSWORD=
# Fernet key for encrypted personal broker credentials. Preserve it across deployments.
PLATFORM_BROKER_ENCRYPTION_KEY=
PLATFORM_SESSION_TTL_SECONDS=43200


# --- Agent pilot: opt-in Compose profile agents ---
# Model calls require AGENTS_ENABLED, LLM_ENABLED, a machine key, and explicit conservative rates.
AGENTS_ENABLED=false
AGENTS_RESTART_POLICY=no
AGENTS_MAX_OUTPUT_TOKENS=8192
AGENTS_PLATFORM_URL=http://localhost:8002
AGENTS_PLATFORM_SERVICE_KEY=
PLATFORM_AGENT_MODEL_ID=
PLATFORM_AGENT_INPUT_USD_PER_MILLION=
PLATFORM_AGENT_OUTPUT_USD_PER_MILLION=
PLATFORM_AGENT_MONTHLY_USD_CAP=10
PLATFORM_AGENT_JOB_USD_CAP=0.25
AGENTS_USAGE_LOG_PATH=logs/agents/agent-model-usage.jsonl
GEMINI_API_KEY=
